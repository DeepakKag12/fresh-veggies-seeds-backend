# Server Configuration
PORT=5000
NODE_ENV=production

# Frontend URL (for CORS)
FRONTEND_URL=https://your-frontend-domain.com

# MongoDB Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database-name

# JWT Configuration
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_EXPIRE=7d

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Brevo (Sendinblue) SMTP — for transactional emails
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-brevo-smtp-user
BREVO_SMTP_PASS=your-brevo-smtp-password
BREVO_FROM_EMAIL=noreply@yourdomain.com

# Admin Alert Email — receives low-stock notifications
# Can be same as BREVO_FROM_EMAIL or a different email you check regularly
ADMIN_ALERT_EMAIL=admin@yourdomain.com

# Low Stock Threshold — products below this count trigger an email alert (default: 10)
LOW_STOCK_THRESHOLD=10

# ─── Razorpay (payments) ──────────────────────────────────────────────────────
# Required — the server exits at boot without these.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# From Razorpay Dashboard → Settings → Webhooks. Used to verify webhook signatures.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ─── Admin order alerts ───────────────────────────────────────────────────────
# WhatsApp number that receives a message on every new order (digits only,
# Indian number). Leave unset to skip WhatsApp alerts — email still goes out.
ADMIN_WHATSAPP_NUMBER=9876543210

# Twilio credentials for WhatsApp/SMS. Unset = messages are logged to the
# console instead of sent, which is fine for local development.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=your-twilio-api-secret
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+14155238886

# ─── DTDC (shipping) ──────────────────────────────────────────────────────────
DTDC_API_URL=https://api.dtdc.in
DTDC_API_KEY=your-dtdc-api-key
DTDC_CUSTOMER_ID=your-dtdc-customer-id

# ─── MSG91 (SMS OTP verification only — server-side only) ──────────────────────
# Private AuthKey for server-to-server token verification
MSG91_AUTH_KEY=your-msg91-auth-key-here

# Warehouse pickup address printed on the shipping label.
DTDC_PICKUP_NAME=Fresh Veggies Warehouse
DTDC_PICKUP_PHONE=9876543210
DTDC_PICKUP_ADDRESS=123 Garden Street
DTDC_PICKUP_CITY=Indore
DTDC_PICKUP_STATE=Madhya Pradesh
DTDC_PICKUP_PINCODE=452001

# ─── Rate limits (requests per window, per IP) ────────────────────────────────
# Optional — these defaults apply when unset. Raise them if legitimate users
# share an IP (office/campus NAT); lower them under attack.
RATE_LIMIT_AUTH=10       # login + register, per 15 min
RATE_LIMIT_OTP=5         # OTP send/verify, per 10 min
RATE_LIMIT_PAYMENT=20    # per 10 min
RATE_LIMIT_ORDER=30      # per 10 min
RATE_LIMIT_GENERAL=200   # all /api routes, per 15 min

# Enables the production data-purge tool for exactly one account. Leave unset to
# disable the capability entirely.
SUPER_ADMIN_EMAIL=

# Require customers to confirm their email before their first sign-in.
# Off by default so the store works without SMTP configured. Set to "true" to
# enforce it (needs the SMTP settings above to be working).
REQUIRE_EMAIL_VERIFICATION=false
